@model GerenciadorAcademico.Models.Projeto

@{
    ViewData["Title"] = "Detalhes do Projeto";
}

<h2>Detalhes do Projeto</h2>

<hr />

<div class="card">

    <div class="card-body">

        <h4 class="card-title">
            @Model.Titulo
        </h4>

        <p class="card-text">
            <strong>Descrição:</strong>
            @Model.Descricao
        </p>

        <p class="card-text">
            <strong>Carga Horária:</strong>
            @Model.CargaHoraria horas
        </p>

        <div class="mt-3">

            <a asp-action="Editar"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Editar
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>

    </div>

</div>a