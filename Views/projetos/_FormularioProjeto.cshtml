@model GerenciadorAcademico.ViewModels.NovoProjetoViewModel

<div class="mb-3">
    <label asp-for="Titulo" class="form-label">Título do Projeto</label>
    <input asp-for="Titulo" class="input" />
    <span asp-validation-for="Titulo" class="validation"></span>
</div>

<div class="mb-3">
    <label asp-for="Descricao" class="form-label">Descrição</label>
    <textarea asp-for="Descricao" class="input" rows="3"></textarea>
    <span asp-validation-for="Descricao" class="validation"></span>
</div>

<div class="mb-3">
    <label asp-for="CargaHoraria" class="form-label">Carga Horária (Horas)</label>
    <input asp-for="CargaHoraria" type="number" class="input" />
    <span asp-validation-for="CargaHoraria" class="validation"></span>
</div>

<div class="mb-3">
    <label asp-for="ProfessorId" class="form-label">Professor Responsável</label>
    <select asp-for="ProfessorId" asp-items="Model.Professores" class="input">
        <option value="">-- Selecione um Professor --</option>
    </select>
    <span asp-validation-for="ProfessorId" class="validation"></span>
</div>
